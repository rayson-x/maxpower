# Local contract runtime (never valid with NODE_ENV=production)
NODE_ENV=development
MAXPOWER_RUNTIME=memory
PORT=8787

# Production requires every value below. Inject secrets from the deployment
# secret manager; do not commit a populated .env file.
# NODE_ENV=production
# MAXPOWER_RUNTIME=production
# PORT=8787
# DATABASE_URL=postgresql://user:password@db.example:5432/maxpower?sslmode=verify-full
# RATE_LIMIT_REDIS_URL=rediss://rate-limit.redis.example:6380/0
# STREAM_REDIS_URL=rediss://volatile-stream.redis.example:6380/0
# STREAM_REDIS_PERSISTENCE=disabled
# HTTP_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
# HTTP_MAX_REQUEST_BYTES=1048576
# HTTP_RATE_LIMIT_REQUESTS=120
# HTTP_RATE_LIMIT_WINDOW_SECONDS=60
# HTTP_TRUST_PROXY_HEADERS=controlled-ingress-only

# AUTH_BASE_URL=https://api.example.com
# AUTH_SECRET=replace-with-at-least-32-random-characters
# AUTH_PHONE_IDENTITY_DOMAIN=phone-id.example.invalid
# AUTH_TERMS_VERSION=2026-08-10
# AUTH_NATIVE_SCHEMES=maxpower://
# SERVICE_JWT_ISSUER=https://api.example.com
# SERVICE_JWT_AUDIENCE=maxpower-api
# GOOGLE_CLIENT_IDS=google-web-client,google-ios-client,google-android-client
# GOOGLE_CLIENT_SECRET=replace-from-secret-manager
# APPLE_CLIENT_IDS=com.example.maxpower.service,com.example.maxpower
# APPLE_CLIENT_SECRET=replace-with-current-apple-client-secret-jwt
# APPLE_BUNDLE_IDENTIFIER=com.example.maxpower
# OTP_DELIVERY_ENDPOINT=https://notifications.example.com/v1/otp
# OTP_DELIVERY_BEARER_TOKEN=replace-from-secret-manager

# S3_ENDPOINT=https://objects.example.com
# S3_REGION=us-east-1
# S3_BUCKET=maxpower-private-media
# S3_ACCESS_KEY_ID=replace-from-secret-manager
# S3_SECRET_ACCESS_KEY=replace-from-secret-manager
# S3_FORCE_PATH_STYLE=false
# MEDIA_TRANSFER_EXPIRY_SECONDS=900

# LLM_PROVIDER_ENDPOINT=https://provider.example.com/v1/chat/completions
# LLM_PROVIDER_API_KEY=replace-from-secret-manager
# LLM_PROVIDER_ID=primary-openai-compatible
# LLM_FINGERPRINT_SECRET=replace-with-at-least-32-random-characters
# LLM_MONTHLY_FREE_CREDITS=2500
# LLM_COACH_MODEL=provider-coach-model
# LLM_COACH_INPUT_CREDITS_PER_MILLION=1000
# LLM_COACH_OUTPUT_CREDITS_PER_MILLION=2000
# LLM_COACH_PROVIDER_INPUT_COST_MICROS_PER_MILLION=1500
# LLM_COACH_PROVIDER_OUTPUT_COST_MICROS_PER_MILLION=6000
# LLM_COACH_PRICING_VERSION_ID=coach-pricing-v1
# LLM_COACH_MAX_INPUT_BYTES=65536
# LLM_COACH_MAX_INPUT_TOKENS=131072
# LLM_COACH_MAX_OUTPUT_TOKENS=4096
# LLM_COACH_MAX_IMAGES=4
# LLM_COACH_MAX_IMAGE_BYTES=65536
# LLM_NUTRITION_MODEL=provider-vision-model
# LLM_NUTRITION_INPUT_CREDITS_PER_MILLION=3000
# LLM_NUTRITION_OUTPUT_CREDITS_PER_MILLION=4000
# LLM_NUTRITION_PROVIDER_INPUT_COST_MICROS_PER_MILLION=2500
# LLM_NUTRITION_PROVIDER_OUTPUT_COST_MICROS_PER_MILLION=10000
# LLM_NUTRITION_PRICING_VERSION_ID=nutrition-pricing-v1
# LLM_NUTRITION_MAX_INPUT_BYTES=524288
# LLM_NUTRITION_MAX_INPUT_TOKENS=1048576
# LLM_NUTRITION_MAX_OUTPUT_TOKENS=2048
# LLM_NUTRITION_MAX_IMAGES=4
# LLM_NUTRITION_MAX_IMAGE_BYTES=393216

# DELETION_WORKER_POLL_MS=1000

# Optional release validation. Tokens are short-lived staging-user service JWTs
# supplied by CI. Primary credentials unset skips; scenario credentials unset
# after primary configuration blocks the full release smoke.
# MAXPOWER_STAGING_BASE_URL=https://staging-api.example.com
# MAXPOWER_STAGING_ACCESS_TOKEN=replace-with-ephemeral-staging-service-jwt
# MAXPOWER_STAGING_DATABASE_URL=postgresql://smoke_readonly:replace@staging-db.example.com/maxpower?sslmode=verify-full
# MAXPOWER_STAGING_SCENARIO_BASE_URL=https://staging-scenarios.example.com
# MAXPOWER_STAGING_SCENARIO_ACCESS_TOKEN=replace-with-ephemeral-scenario-service-jwt
# MAXPOWER_STAGING_SCENARIO_DATABASE_URL=postgresql://smoke_readonly:replace@scenario-db.example.com/maxpower?sslmode=verify-full
# Comma-separated built artifact roots. Defaults to server/dist.
# MAXPOWER_RELEASE_SCAN_PATHS=dist
