{
  "name": "@maxpower/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "migrate": "tsx src/migrate.ts",
    "migrate:prod": "node dist/migrate.js",
    "worker": "tsx src/worker.ts",
    "worker:prod": "node dist/worker.js",
    "admin:grant": "tsx src/runtime/production/admin-grant.ts",
    "admin:grant:prod": "node dist/runtime/production/admin-grant.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/**/*.test.ts",
    "check": "npm run typecheck && npm test",
    "release:privacy": "node --import tsx --test test/auth-production-social-exchange.test.ts test/http-security.test.ts test/llm.test.ts test/production-otp-delivery.test.ts test/production-worker.test.ts",
    "release:integration": "node --import tsx src/runtime/production/release-integration-gate.ts",
    "release:scan": "node dist/runtime/production/release-scan.js",
    "release:provider-smoke": "node dist/runtime/production/staging-provider-smoke.js",
    "release:check": "npm run check && npm run release:integration && npm run build && npm run release:scan",
    "release:verify": "npm run release:check && npm run release:provider-smoke"
  },
  "dependencies": {
    "@hono/node-server": "2.1.0",
    "better-auth": "1.6.26",
    "hono": "4.13.1",
    "jose": "6.2.8",
    "pg": "8.23.0",
    "redis": "6.2.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/pg": "8.21.0",
    "tsx": "4.23.11",
    "typescript": "7.0.2"
  }
}
