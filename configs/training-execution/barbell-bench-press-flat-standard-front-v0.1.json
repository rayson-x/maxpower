    },
    {
      "phase": "expected_concentric_ascent",
      "observedTask": "bar ascends while both elbows extend and the bilateral path remains coordinated"
    },
    {
      "phase": "returned_lockout",
      "observedTask": "bar returns to the selected endpoint and the rep is sealed"
    }
  ],
