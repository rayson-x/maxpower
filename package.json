    "evaluate:observed-recognition-profiles": "tsc -p tools/recognition-profile/tsconfig.json && node .recognition-profile-build/tools/recognition-profile/evaluate.js",
    "generate:provisional-reference": "tsc -p tools/reference-trajectory/tsconfig.json && node .reference-trajectory-build/tools/reference-trajectory/generate.js",
    "generate:simulated-priors": "tsc -p tools/simulated-kinematic-prior/tsconfig.json && node .simulated-prior-build/tools/simulated-kinematic-prior/generate.js",
    "prepare:mmfit": "python3 tools/external-fitness-data/prepare_mmfit.py --input data/external/mm-fit/pose-labels --output data/external/mm-fit/normalized",
    "setup:mmfit:rgb-runtime": "tools/external-fitness-data/setup_mmfit_rgb_runtime.sh",
    "prepare:mmfit:rgb": "tools/external-fitness-data/extract_mmfit_rgb_train.sh --parallel 4",
