{
  "name": "form-coach",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@mariozechner/pi-agent-core": "^0.73.1",
    "@mariozechner/pi-ai": "^0.73.1",
    "@mediapipe/tasks-vision": "^1.0.1",
    "expo": "~57.0.9",
    "expo-dev-client": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "onnxruntime-web": "^1.22.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:motion-wasm": "sh tools/motion-sdk/build-wasm.sh",
    "web": "npm run build:motion-wasm && expo start --web",
    "test:rust": "sh tools/motion-sdk/test-rust.sh",
    "test:motion-parity": "npm run build:motion-wasm && tsc -p tools/motion-sdk/tsconfig.eval.json && node .motion-sdk-eval-build/tools/motion-sdk/parity.js",
    "benchmark:rust-motion": "cargo run --release --manifest-path rust/motion-sdk/Cargo.toml --bin motion_benchmark",
    "evaluate:rust-motion": "npm run build:motion-wasm && tsc -p tools/motion-sdk/tsconfig.eval.json && node .motion-sdk-eval-build/tools/motion-sdk/evaluate.js",
    "harness": "tsc -p tools/harness/tsconfig.json && node .harness-build/tools/harness/analyze.js",
    "validate:labeled-fixture": "tsc -p tools/labeled-set-fixture/tsconfig.json && node .labeled-fixture-build/tools/labeled-set-fixture/validate.js",
    "validate:home-workout": "tsc -p tools/home-workout-validation/tsconfig.json && node .home-workout-validation-build/tools/home-workout-validation/evaluate.js",
    "train:segmentation": "tsc -p tools/segmentation-training/tsconfig.json && node .segmentation-training-build/tools/segmentation-training/train.js",
    "generate:observed-recognition-profiles": "tsc -p tools/recognition-profile/tsconfig.json && node .recognition-profile-build/tools/recognition-profile/generate.js",
    "generate:provisional-reference": "tsc -p tools/reference-trajectory/tsconfig.json && node .reference-trajectory-build/tools/reference-trajectory/generate.js",
    "generate:simulated-priors": "tsc -p tools/simulated-kinematic-prior/tsconfig.json && node .simulated-prior-build/tools/simulated-kinematic-prior/generate.js",
    "test": "tsc -p tsconfig.test.json && node .test-build/tools/runTests.js"
  },
  "private": true
}
