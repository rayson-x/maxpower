    "audit:mmfit:rtmpose-halpe26": "/usr/bin/arch -arm64 data/workflows/pose-stack/runtime/.venv/bin/python tools/external-fitness-data/audit_mmfit_rtmpose_halpe26.py --input data/external/mm-fit/native-rtmpose-halpe26 --output data/workflows/motion-profile/mmfit-halpe26-v1/run-2026-08-11/diagnostics/mmfit-train-rtmpose-corpus-audit-v1.json",
    "build:trajectory-database:native-halpe26-v2": "python3 tools/action-trajectory-database/build_native_halpe26_v2.py --personal-dataset data/training/personal-golden-segmentation-v2.json --personal-canonical data/workflows/motion-profile/personal-halpe26-v1/run-2026-08-11/corpus/personal-rust-canonical-v2.json --personal-cycle-model data/workflows/motion-profile/personal-halpe26-v1/run-2026-08-11/candidates/personal-cycle-state-halpe26-v1.json --personal-cycle-report data/workflows/motion-profile/personal-halpe26-v1/run-2026-08-11/diagnostics/personal-cycle-state-halpe26-v1-loo.json --mmfit-manifest data/external/mm-fit/native-rtmpose-halpe26/manifest.json --mmfit-canonical data/workflows/motion-profile/mmfit-halpe26-v1/run-2026-08-11/corpus/mmfit-train-rust-canonical-v1.json --mmfit-audit data/workflows/motion-profile/mmfit-halpe26-v1/run-2026-08-11/diagnostics/mmfit-train-rtmpose-corpus-audit-v1.json --mmfit-prior-model data/workflows/motion-profile/mmfit-halpe26-v1/run-2026-08-11/candidates/mmfit-train-periodicity-prior-v1.json --mmfit-report data/workflows/motion-profile/mmfit-halpe26-v1/run-2026-08-11/diagnostics/mmfit-train-periodicity-loso-v1.json --technique-dataset data/workflows/action-trajectory-database/halpe26-v1/technique-training-dataset-v1.json --runtime-parity docs/reports/real-halpe26-cross-platform-runtime-parity-2026-08-11.json --output data/workflows/action-trajectory-database/native-halpe26-v2/manifest.json",
    "test:trajectory-database:native-halpe26-v2": "python3 -m unittest tools/action-trajectory-database/test_build_native_halpe26_v2.py",
    "merge:mmfit:rgb-shards": "data/workflows/motion-profile/runtime/mmfit-mediapipe/.venv/bin/python tools/external-fitness-data/merge_mmfit_rgb_pose_shards.py",
    "test:mmfit-rgb-extractor": "python3 -m unittest tools/external-fitness-data/test_extract_mmfit_rgb_pose.py",
    "test:mmfit-rtmpose-extractor": "/usr/bin/arch -arm64 data/workflows/pose-stack/runtime/.venv/bin/python -m unittest tools/external-fitness-data/test_extract_mmfit_rgb_halpe26.py tools/external-fitness-data/test_audit_mmfit_rtmpose_halpe26.py",
    "analyze:mmfit-orientation": "python3 tools/external-fitness-data/analyze_mmfit_view.py --input data/external/mm-fit/pose-labels --output data/external/mm-fit/normalized/body-orientation-analysis.json",
    "benchmark:mmfit": "tsc -p tools/external-fitness-data/tsconfig.json && node .external-fitness-data-build/tools/external-fitness-data/benchmarkMmFit.js",
    "benchmark:mmfit:candidates": "tsc -p tools/external-fitness-data/tsconfig.json && node .external-fitness-data-build/tools/external-fitness-data/benchmarkMmFit.js data/external/mm-fit/normalized docs/reports/mmfit-candidate-profile-benchmark-2026-08-09.json data/external/mm-fit/normalized/candidate-profiles.json data/external/mm-fit/normalized/body-orientation-analysis.json",
    "benchmark:mmfit:periodicity": "python3 tools/external-fitness-data/benchmark_mmfit_periodicity.py",
    "train:mmfit-profiles": "tsc -p tools/external-fitness-data/tsconfig.json && node .external-fitness-data-build/tools/external-fitness-data/trainMmFitProfiles.js",
    "report:recognition-corpus": "tsc -p tools/external-fitness-data/tsconfig.json && node .external-fitness-data-build/tools/external-fitness-data/unifiedRecognitionCorpusGate.js",
    "workflow:motion-profile": "tsc -p tools/motion-profile-workflow/tsconfig.json && node .motion-profile-workflow-build/tools/motion-profile-workflow/cli.js",
    "test:motion-profile-workflow": "tsc -p tools/motion-profile-workflow/tsconfig.test.json && node --test .motion-profile-workflow-test-build/tools/motion-profile-workflow/workflow.test.js",
    "gate:recognition-corpus": "npm run report:recognition-corpus -- --enforce",
    "test:external-fitness-data": "tsc -p tools/external-fitness-data/tsconfig.test.json && node --test .external-fitness-data-test-build/tools/external-fitness-data/externalFitnessData.test.js .external-fitness-data-test-build/tools/external-fitness-data/rollingProfileTrainer.test.js .external-fitness-data-test-build/tools/external-fitness-data/unifiedRecognitionCorpusGate.test.js .external-fitness-data-test-build/tools/exercise-registry/exerciseRegistry.test.js .external-fitness-data-test-build/tools/mobile-mvp/mobileDataLayer.test.js .external-fitness-data-test-build/tools/muscle-association/muscleAssociationDatabase.test.js .external-fitness-data-test-build/tools/simulated-kinematic-prior/simulatedKinematicPrior.test.js",
    "test": "tsc -p tsconfig.test.json && node .test-build/tools/runTests.js"
  },
