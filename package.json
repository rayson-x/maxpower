    "build:mmfit-dumbbell-review-queue": "python3 tools/equipment-validation/build_mmfit_dumbbell_review_queue.py",
    "materialize:mmfit-dumbbell-review-queue": "python3 tools/equipment-validation/build_mmfit_dumbbell_review_queue.py --execute",
    "test:mmfit-dumbbell-review-queue": "python3 -m unittest tools/equipment-validation/test_build_mmfit_dumbbell_review_queue.py",
