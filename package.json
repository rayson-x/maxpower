    "evaluate:personal-halpe26-temporal-profile:rust": "cargo run --release --manifest-path rust/motion-sdk/Cargo.toml --bin temporal_template_replay -- --dataset data/training/personal-golden-segmentation-v2.json --canonical-sequences data/workflows/motion-profile/personal-halpe26-v1/run-2026-08-11/corpus/personal-rust-canonical-v2.json --model data/workflows/motion-profile/personal-halpe26-v1/run-2026-08-11/candidates/personal-temporal-template-halpe26-v2.json --output data/workflows/motion-profile/personal-halpe26-v1/run-2026-08-11/diagnostics/personal-temporal-template-halpe26-v2-rust-replay.json",
    "gate:personal-halpe26-temporal-profile:rust": "npm run evaluate:personal-halpe26-temporal-profile:rust -- --require-golden-exact",
    "train:personal-temporal-profile": "python3 tools/recognition-profile/trainTemporalTemplates.py --dataset data/training/personal-golden-segmentation-v2.json --archive public/archives/confirmed-captures --canonical-sequences data/workflows/motion-profile/personal-golden-v2/run-2026-08-10/corpus/personal-rust-canonical-v1.json --model-output data/workflows/motion-profile/personal-golden-v2/run-2026-08-10/candidates/personal-temporal-template-v1.json --output data/workflows/motion-profile/personal-golden-v2/run-2026-08-10/diagnostics/personal-temporal-template-v1-replay.json",
    "test:personal-temporal-profile": "python3 -m unittest tools/recognition-profile/test_train_temporal_templates.py tools/recognition-profile/test_check_temporal_generalization.py tools/recognition-profile/test_train_cycle_state_profiles.py tools/recognition-profile/test_check_cycle_state_generalization.py tools/recognition-profile/test_evaluate_blind_video_acceptance.py tools/recognition-profile/test_train_mmfit_halpe26_priors.py tools/recognition-profile/test_check_mmfit_halpe26_periodicity.py",
