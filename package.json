    "gate:personal-halpe26-blind-video": "npm run report:personal-halpe26-blind-video -- --enforce",
    "report:bench-pose-equipment-diagnostic": "python3 tools/equipment-validation/evaluate_pose_equipment_fusion.py --dataset data/training/personal-golden-segmentation-v2.json --canonical data/workflows/motion-profile/personal-halpe26-v1/run-2026-08-11/corpus/personal-rust-canonical-v2.json --pose-report data/workflows/motion-profile/personal-halpe26-v1/run-2026-08-11/diagnostics/personal-cycle-state-halpe26-v1-loo.json --equipment-report data/workflows/equipment-validation/bar-axis-v1/legacy-evaluation.json --output data/workflows/equipment-pose-alignment-prototype/front-bench-v1/run-2026-08-12/pose-equipment-diagnostic.json",
    "test:bench-pose-equipment-diagnostic": "python3 -m unittest tools/equipment-validation/test_evaluate_pose_equipment_fusion.py",
