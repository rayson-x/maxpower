    "export:personal-halpe26-rust-canonical": "npm run build:motion-wasm && tsc -p tools/recognition-profile/tsconfig.json && node .recognition-profile-build/tools/recognition-profile/exportPersonalHalpe26CanonicalSequences.js --dataset data/training/personal-golden-segmentation-v2.json --sidecars data/workflows/action-trajectory-database/halpe26-v1/personal-observations --wasm public/motion-sdk/maxpower_motion_sdk.wasm --output data/workflows/motion-profile/personal-halpe26-v1/run-2026-08-11/corpus/personal-rust-canonical-v2.json",
    "export:mmfit-halpe26-rust-canonical": "npm run build:motion-wasm && tsc -p tools/recognition-profile/tsconfig.json && node .recognition-profile-build/tools/recognition-profile/exportMmfitHalpe26CanonicalSequences.js --input data/external/mm-fit/native-rtmpose-halpe26 --wasm public/motion-sdk/maxpower_motion_sdk.wasm --output data/workflows/motion-profile/mmfit-halpe26-v1/run-2026-08-11/corpus/mmfit-train-rust-canonical-v1.json",
