    "train:personal-halpe26-cycle-profile": "/usr/bin/arch -arm64 data/workflows/pose-stack/runtime/.venv/bin/python tools/recognition-profile/trainCycleStateProfiles.py --dataset data/training/personal-golden-segmentation-v2.json --archive public/archives/confirmed-captures --canonical-sequences data/workflows/motion-profile/personal-halpe26-v1/run-2026-08-11/corpus/personal-rust-canonical-v2.json --model-output data/workflows/motion-profile/personal-halpe26-v1/run-2026-08-11/candidates/personal-cycle-state-halpe26-v1.json --output data/workflows/motion-profile/personal-halpe26-v1/run-2026-08-11/diagnostics/personal-cycle-state-halpe26-v1-loo.json",
    "train:mmfit-halpe26-periodicity-priors": "/usr/bin/arch -arm64 data/workflows/pose-stack/runtime/.venv/bin/python tools/recognition-profile/trainMmfitHalpe26Priors.py --canonical-sequences data/workflows/motion-profile/mmfit-halpe26-v1/run-2026-08-11/corpus/mmfit-train-rust-canonical-v1.json --model-output data/workflows/motion-profile/mmfit-halpe26-v1/run-2026-08-11/candidates/mmfit-train-periodicity-prior-v1.json --output data/workflows/motion-profile/mmfit-halpe26-v1/run-2026-08-11/diagnostics/mmfit-train-periodicity-loso-v1.json",
    "gate:mmfit-halpe26-periodicity": "python3 tools/recognition-profile/checkMmfitHalpe26Periodicity.py data/workflows/motion-profile/mmfit-halpe26-v1/run-2026-08-11/diagnostics/mmfit-train-periodicity-loso-v1.json --minimum 0.95 --expected-clips 301",
    "gate:personal-halpe26-cycle-generalization": "python3 tools/recognition-profile/checkCycleStateGeneralization.py data/workflows/motion-profile/personal-halpe26-v1/run-2026-08-11/diagnostics/personal-cycle-state-halpe26-v1-loo.json --minimum 0.95",
