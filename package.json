    "build:annotation-inbox": "tsc -p tools/annotation-inbox/tsconfig.json",
    "build:recognition-review": "tsc -p tools/recognition-review/tsconfig.json",
    "review:recognition": "npm run build:recognition-review && node .recognition-review-build/tools/recognition-review/start.js",
    "build:technique-training-dataset": "npm run build:recognition-review && node .recognition-review-build/tools/recognition-review/buildTechniqueDataset.js",
    "gate:technique-training-dataset": "npm run build:technique-training-dataset -- --require-eligible",
