    "test:realtime-bench-stream": "/usr/bin/arch -arm64 data/workflows/pose-stack/runtime/.venv/bin/python -m unittest discover -s tools/equipment-validation -p 'test_*realtime_bench_stream.py'",
    "test:single-pass-bench": "/usr/bin/arch -arm64 data/workflows/pose-stack/runtime/.venv/bin/python -m unittest tools/equipment-validation/test_run_single_pass_bench_acceptance.py",
    "report:single-pass-bench": "/usr/bin/arch -arm64 data/workflows/pose-stack/runtime/.venv/bin/python tools/equipment-validation/run_single_pass_bench_acceptance.py",
