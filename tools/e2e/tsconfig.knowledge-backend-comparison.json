{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "../../.knowledge-backend-comparison-build",
    "rootDir": "../..",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": false,
    "noEmitOnError": true,
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "../../src/agent-knowledge/**/*.ts",
    "./KnowledgeBackendComparisonHarness.ts",
    "../agent-knowledge/installedAgentKnowledge.test.ts",
    "../agent-knowledge/knowledgeReleaseAcceptance.test.ts",
    "./personalPlannerFixture.ts",
    "./agentKnowledgePersonalPlan.e2e.test.ts",
    "./knowledgeBackendComparison.e2e.test.ts",
    "./runKnowledgeBackendComparison.ts"
  ]
}
