{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "../../.harness-build",
    "rootDir": "../..",
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "noEmitOnError": false,
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "analyze.ts"
  ]
}